# Copy this file to ".env" (same folder) and fill in what you have. Everything is optional.

PORT=5000
JWT_SECRET=change-this-to-any-long-random-text

# Free key from https://aistudio.google.com/apikey
# Leave empty to start in demo mode. You can also paste the key later in the app (Settings page).
GEMINI_API_KEY=

# MongoDB Atlas connection string. Leave empty to store data in backend/data/db.json instead.
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/admitra?retryWrites=true&w=majority
MONGODB_URI=

# Advanced: models and time limits (milliseconds). The defaults are fine.
# TEXT_MODEL=gemini-3.8-flash
# IMAGE_MODELS=gemini-3.1-flash-lite-image,gemini-nano-banana-2.1,gemini-2.5-flash-image
# TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts
# TEXT_TIMEOUT_MS=40000
# IMAGE_TIMEOUT_MS=45000
# IMAGES_TOTAL_MS=70000
